# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
build/
dist/
.venv/
venv/
.env

# IDE
.vscode/
.idea/
.DS_Store

# Real alumni data stays off the repo, per the CLAUDE.md privacy rule
stew-real.json
stew-real.*

# Privacy backstops for any other local event data
private/
data/
tests/private/
*.csv
*.xlsx

# Original full-size photos with camera metadata stay local
*.JPG
*.JPEG
*.HEIC
*.heic
# Web-ready copies are resized and stripped of metadata, so they are allowed
!docs/images/*.jpg
!docs/images/tables/*.jpg
# Public templates hold the example dinner at the theme level, no names
!templates/*.csv
